oracle_trade_executions_raw_to_bronze

dptf_last_run_id:
cbd1e4a9-8d42-4d2f-9f17-7ab6e03eb10a

dptf_last_run_status:
SUCCESS

dptf_last_run_time:
2026-07-24 13:35:12 UTC

dptf_last_processed_partition_time:
2026-07-24 12:00:00 UTC

dptf_partition_format:
HOURLY

dptf_partition_timezone:
UTC

dptf_source_ids:
["s3.raw.oracle_trade.TRADE.EXECUTIONS"]

dptf_target_ids:
["iceberg.bronze_trade.executions_cdc"]
